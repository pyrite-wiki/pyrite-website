---
import "../assets/styles.css";
import Nav from "../components/Nav.astro";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Knowledge-as-Code for humans and AI agents" } =
  Astro.props;
---

<!doctype html>
<html lang="en" class="bg-surface text-text-primary">
  <head>
    <Head title={title} description={description} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <slot name="banner" />
    <Nav />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
