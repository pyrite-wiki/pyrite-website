---
import { community } from "../data/release";
---

<section id="community" aria-labelledby="community-title" class="home-section pb-[clamp(64px,8vw,112px)]">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-x-16 gap-y-10 p-[clamp(28px,4vw,48px)] bg-surface-raised border border-line rounded-[10px]">
    <div class="flex flex-col gap-4">
      <div class="eyebrow">Community</div>
      <h2 id="community-title" class="section-title">Pyrite is a community project now.</h2>
      <p class="text-base text-text-secondary text-pretty">
        Bugs, docs that drift from the code, and roadmap items are all open on
        GitHub. Multi-user hardening is where help matters most right now.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a class="btn btn-secondary min-h-11 px-[18px] text-sm" href="https://github.com/pyrite-wiki/pyrite/blob/main/CONTRIBUTING.md">Read CONTRIBUTING</a>
        <a class="btn btn-secondary min-h-11 px-[18px] text-sm" href="https://github.com/pyrite-wiki/pyrite/issues">Browse open issues</a>
        <a class="btn btn-secondary min-h-11 px-[18px] text-sm" href="/community">Meet the contributors</a>
      </div>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(150px,100%),1fr))] gap-6 content-center">
      <div class="flex flex-col gap-1">
        <span class="font-serif font-semibold text-[44px] leading-[1.1] tabular-nums">{community.people}</span>
        <span class="text-[13px] text-text-secondary">
          contributors, from {community.outsideContributorsAtPrevious + 1} at v{community.previousVersion}
        </span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-serif font-semibold text-[44px] leading-[1.1] tabular-nums">{community.outsidePrs}</span>
        <span class="text-[13px] text-text-secondary">pull requests merged from contributors</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-serif font-semibold text-[44px] leading-[1.1] tabular-nums">
          {community.openPrsFromContributors}<span class="text-[22px] text-text-secondary"> / {community.openPrs}</span>
        </span>
        <span class="text-[13px] text-text-secondary">open pull requests come from contributors</span>
      </div>
    </div>
  </div>
</section>
