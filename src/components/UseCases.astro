---
import { counts } from "../data/release";

const words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const extensionCount = words[counts.extensions] ?? String(counts.extensions);

const cases = [
  {
    title: "Research and investigations",
    description:
      "People, organizations, events and relationships across sources, with timeline and graph views.",
    link: "/use-cases#research",
    tags: ["core"],
  },
  {
    title: "Software teams",
    description:
      "ADRs, components, backlog items, standards and runbooks: structured, validated and searchable.",
    link: "/use-cases#software",
    tags: ["software-kb"],
  },
  {
    title: "Personal knowledge",
    description: "Notes that mature: capture, elaborate, question, refine, connect.",
    link: "/use-cases#personal",
    tags: ["zettelkasten"],
  },
  {
    title: "Team wikis",
    description: "About $6 a month on a small VPS. Multi-user is still experimental.",
    link: "#self-host",
    tags: ["self-hosted"],
  },
];
---

<section id="use-cases" aria-labelledby="uses-title" class="home-section flex flex-col gap-10">
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <div class="flex flex-col gap-4 max-w-[40rem]">
      <div class="eyebrow">Use cases</div>
      <h2 id="uses-title" class="section-title">One engine, shaped by extensions</h2>
    </div>
    <a href="/plugins" class="link text-sm font-medium py-3">All {extensionCount} extensions</a>
  </div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4">
    {
      cases.map((c) => (
        <a
          href={c.link}
          class="flex flex-col gap-3 p-6 bg-surface-raised border border-line rounded-[10px] text-text-primary no-underline hover:border-text-muted transition-colors"
        >
          <span class="text-base font-semibold leading-[1.4]">{c.title}</span>
          <span class="text-sm text-text-secondary leading-[1.55] grow">{c.description}</span>
          <span class="flex flex-wrap gap-1.5">
            {c.tags.map((t) => <span class="chip">{t}</span>)}
          </span>
        </a>
      ))
    }
  </div>
  <p class="text-sm text-text-secondary">
    Need your own shape? Extensions add entry types, MCP tools, CLI commands,
    validators and lifecycle hooks. <a href="/docs/plugin-protocol" class="link">Write a plugin</a>
  </p>
</section>
