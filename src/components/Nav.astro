---
import Logo from "./Logo.astro";
---

<header class="border-b border-line">
  <div class="max-w-[1200px] mx-auto px-[clamp(16px,4vw,40px)] py-3.5 flex flex-wrap items-center gap-x-8 gap-y-3">
    <a href="/" aria-label="Pyrite home" class="flex items-center gap-2.5 no-underline text-text-primary min-h-11">
      <Logo detailed />
      <span class="font-serif font-semibold text-[23px] tracking-[-0.01em] leading-none">pyrite</span>
    </a>
    <nav class="nav flex flex-wrap items-center gap-x-6 text-[13.5px] font-medium flex-auto" aria-label="Primary">
      <a href="/docs" class="py-3">Docs</a>
      <a href="/use-cases" class="py-3">Use cases</a>
      <a href="/plugins" class="py-3">Plugins</a>
      <a href="/blog" class="py-3">Blog</a>
      <a href="/community" class="py-3">Community</a>
    </nav>
    <div class="flex items-center gap-2.5">
      <a class="btn btn-secondary min-h-10 px-3.5 text-[13.5px]" href="https://github.com/pyrite-wiki/pyrite">GitHub</a>
      <a class="btn btn-primary min-h-10 px-4 text-[13.5px]" href="https://demo.pyrite.wiki">Try the demo</a>
    </div>
  </div>
</header>
