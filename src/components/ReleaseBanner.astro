---
import { release } from "../data/release";
---

<div class="bg-surface-raised border-b border-line text-[13px] leading-[1.45]">
  <div class="max-w-[1200px] mx-auto px-[clamp(16px,4vw,40px)] py-2.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center">
    <span class="font-mono text-xs text-brand">v{release.version}</span>
    <span class="text-text-secondary">{release.bannerNote}</span>
    <a href={release.url} class="link font-medium">Release notes</a>
  </div>
</div>
