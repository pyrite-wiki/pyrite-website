---
import Base from "../layouts/Base.astro";
import ReleaseBanner from "../components/ReleaseBanner.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Features from "../components/Features.astro";
import Architecture from "../components/Architecture.astro";
import MCP from "../components/MCP.astro";
import UseCases from "../components/UseCases.astro";
import QuickStart from "../components/QuickStart.astro";
import Community from "../components/Community.astro";
---

<Base
  title="Pyrite — knowledge as code"
  description="Pyrite keeps what you know as typed markdown in git, checked against a schema and shared with AI agents through MCP."
>
  <ReleaseBanner slot="banner" />
  <Hero />
  <Stats />
  <Features />
  <Architecture />
  <MCP />
  <UseCases />
  <QuickStart />
  <Community />
</Base>
